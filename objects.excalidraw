      "boundElements": [],
      "updated": 1749499029902,
      "link": null,
      "locked": false,
      "text": "each a dictionary with the same keys\nkeys=values of split column. Differ only\nin the contents of the df\n\nnb: one-hot encoded anti-split, then nb param\nzi: one-hot encoded replicate, then zi param\ntheta: single value\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "each a dictionary with the same keys\nkeys=values of split column. Differ only\nin the contents of the df\n\nnb: one-hot encoded anti-split, then nb param\nzi: one-hot encoded replicate, then zi param\ntheta: single value\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
